alloc(pmwRRCMem,1000,"PMA_W32_M.exe"+15C229)
label(pmwRRCOriginal)

pmwRRCMem:
  pushfd
  push eax
  // EBP = active state, EBX = player argument in the original Update.
  cmp [ebx+8E4],ebp
  jne pmwRRCOriginal
  mov eax,[ebp]
  cmp eax,"PMA_W32_M.exe"+33D54C
  jne pmwRRCOriginal
  // Copy the current full-charge float bits without touching the x87 stack.
  mov eax,["PMA_W32_M.exe"+39967C]
  mov [ebp+14],eax
pmwRRCOriginal:
  pop eax
  popfd
  mov edx,["PMA_W32_M.exe"+399CF0]
  jmp "PMA_W32_M.exe"+15C22F

"PMA_W32_M.exe"+15C229:
  jmp pmwRRCMem
  db 90

