[ENABLE]
// Tested executable's update prologue and activation entry.
assert("PMA_W32_M.exe"+185590,81 EC A0 00 00 00 53 55 56 8B E9)
assert("PMA_W32_M.exe"+17B270,83 EC 08 E9 93 5D EC FF)
alloc(PMW3GiveMemory,0x1000,"PMA_W32_M.exe"+185590)
label(PMW3GiveCode)
label(PMW3GiveOriginal)
label(PMW3GiveUnlock)
label(PMW3GiveInvalid)
label(PMW3GiveRequest)
label(PMW3GiveBusy)
registersymbol(PMW3GiveRequest)

PMW3GiveMemory:
PMW3GiveRequest:
  dd FFFFFFFF
PMW3GiveBusy:
  dd 0

PMW3GiveCode:
  pushfd
  pushad

  // Only accept the player resolved by the tested pointer chain.
  mov eax,["PMA_W32_M.exe"+3CDF3C]
  test eax,eax
  je PMW3GiveOriginal
  mov eax,[eax+24]
  test eax,eax
  je PMW3GiveOriginal
  cmp eax,ecx
  jne PMW3GiveOriginal

  // Original update sets this field to 1 after its initial setup.
  cmp dword ptr [ecx+7D4],0
  je PMW3GiveOriginal
  cmp dword ptr [PMW3GiveRequest],FFFFFFFF
  je PMW3GiveOriginal

  // Avoid dispatching recursively or concurrently through this hook.
  mov edx,1
  xchg dword ptr [PMW3GiveBusy],edx
  test edx,edx
  jne PMW3GiveOriginal

  // Consume once. Unsigned comparison rejects negatives as well as >= 6.
  mov eax,FFFFFFFF
  xchg dword ptr [PMW3GiveRequest],eax
  cmp eax,5
  ja PMW3GiveInvalid

  // Preserve the caller's x87/SSE state in a 16-byte-aligned 512-byte area.
  // EBX is callee-saved by the game's activation routine.
  mov ebx,esp
  sub esp,210
  and esp,FFFFFFF0
  fxsave [esp]
  fninit
  fldcw word ptr [esp]
  cld

  // thiscall: ECX = player, [ESP+4] = ID at function entry.
  // Activation returns with RET 4, so do not adjust ESP after the call.
  push eax
  call "PMA_W32_M.exe"+17B270

  fxrstor [esp]
  mov esp,ebx
  jmp PMW3GiveUnlock

PMW3GiveInvalid:
PMW3GiveUnlock:
  mov dword ptr [PMW3GiveBusy],0
PMW3GiveOriginal:
  popad
  popfd
  // Replay the entire overwritten instruction, then resume the update.
  sub esp,A0
  jmp "PMA_W32_M.exe"+185596

"PMA_W32_M.exe"+185590:
  jmp PMW3GiveCode
  nop

[DISABLE]
PMW3GiveRequest:
  dd FFFFFFFF
"PMA_W32_M.exe"+185590:
  db 81 EC A0 00 00 00
unregistersymbol(PMW3GiveRequest)
// Intentionally retain this small allocation until the process exits:
// a thread already executing the hook must not return into freed memory.
// Each re-enable allocates another 4 KiB.
